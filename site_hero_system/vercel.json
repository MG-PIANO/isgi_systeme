{
  "version": 2,
  "name": "hero-system",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/HERO_SYSTEM_PLAQUETTE_OFFICIELLE.pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"HERO_SYSTEM_PLAQUETTE_OFFICIELLE.pdf\""
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
